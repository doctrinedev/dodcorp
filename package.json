{
  "name": "@dodcorp/monorepo",
  "version": "0.0.0",
  "private": true,
  "description": "DodCorp packages monorepo",
  "type": "module",
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "build": "pnpm -r --filter './packages/*' run build",
    "typecheck": "tsc --build --force",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "check:api": "node scripts/api-report.mjs",
    "api:update": "node scripts/api-report.mjs --update",
    "check:package": "node scripts/check-package.mjs",
    "check": "pnpm run typecheck && pnpm run lint && pnpm run test && pnpm run build && pnpm run check:api && pnpm run check:package",
    "release:check": "node scripts/check-release-tag.mjs"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@eslint-community/eslint-plugin-eslint-comments": "^4.7.2",
    "@eslint/js": "^9.39.1",
    "@microsoft/api-extractor": "^7.58.13",
    "@types/node": "^20.19.9",
    "@vitest/coverage-v8": "^3.2.4",
    "eslint": "^9.39.1",
    "globals": "^17.8.0",
    "publint": "^0.3.22",
    "tsup": "^8.5.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.4",
    "vitest": "^3.2.4"
  }
}
